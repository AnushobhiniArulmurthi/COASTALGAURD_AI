# CoastalGuard AI — Frontend Environment Variables (Placeholders)
# Copy this file to .env.local when integrating with live backend services.

# Application Configuration
VITE_APP_NAME="CoastalGuard AI"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0-prototype"

# FastAPI Backend Base URL (Defaults to http://127.0.0.1:8000)
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# Marine Data / OpenWeather / INCOIS API Keys (Future Integration)
VITE_WEATHER_API_KEY="placeholder_weather_key"
VITE_MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
