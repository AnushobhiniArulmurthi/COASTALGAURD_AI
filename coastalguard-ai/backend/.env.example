# ==============================================================================
# CoastalGuard AI — Backend Environment Configuration Example
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the backend/ directory:
#      copy .env.example .env
# 2. Update configuration values for your local environment.
# 3. NEVER commit real production API keys, service secrets, or passwords to Git.
# ==============================================================================

# Application Runtime
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# CORS Origins (Comma-separated URLs of allowed frontend clients)
# Defaults to standard Vite dev server origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Demo Mode Flag
# When true, all marine, alert, and telemetry data are explicitly marked as simulation/demo
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Supabase Integration (Planned for Phase 2 - Database & Authentication)
# ------------------------------------------------------------------------------
# In Phase 1, the backend operates in demo/foundation mode without credentials.
# For Phase 2, sign up for a free-tier Supabase project at https://supabase.com
# and fill in your project URL and Public Anon Key:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder
# CRITICAL SECURITY NOTE:
# The service-role key has full admin rights bypassing Row Level Security (RLS).
# It must NEVER be exposed to the browser or frontend clients.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Google Gemini API Integration (Official Google Gen AI SDK)
# ------------------------------------------------------------------------------
# 1. Obtain a free-tier Gemini API key from Google AI Studio:
#    https://aistudio.google.com/
# 2. Add your key below:
GOOGLE_API_KEY=replace_with_your_own_key
# 3. Configurable model selection (supported by your key and quota)
#    Default: gemini-2.5-flash (fast, balanced for interactive chat)
#    Alternatives: gemini-2.5-pro, gemini-3.7-flash
GEMINI_MODEL=gemini-2.5-flash
